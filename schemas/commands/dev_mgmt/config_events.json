        "terminalConnection": true,
        "firmwareUpdate": true,
        "gpi": true,
        "network": true,
        "exceptions": true,
        "ntp": true,
        "userApp": true,
        "heartbeat": true,
        "power": true,
        "battery": true,
        "temperature": true,
        "fileDownload": true,
        "cpuUsage": true,
        "flashUsage": true,
        "ramUsage": true,
